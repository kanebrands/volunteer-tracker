<?xml version="1.0" encoding="utf-8"?>
<extension type="component" method="upgrade">
	<name>COM_VOLUNTEERTRACKER</name>
	<author>Kane Brands LLC</author>
	<creationDate>2026-10-02</creationDate>
	<copyright>(C) 2026. All rights reserved.</copyright>
	<license>GNU General Public License version 2 or later</license>
	<authorEmail></authorEmail>
	<authorUrl>https://github.com/kanebrands</authorUrl>
	<version>1.0.21</version>
	<description>COM_VOLUNTEERTRACKER_XML_DESCRIPTION</description>
	<namespace path="src">VolunteerTracker\Component\VolunteerTracker</namespace>

	<install>
		<sql>
			<file driver="mysql" charset="utf8">sql/install/mysql/install.sql</file>
		</sql>
	</install>

	<uninstall>
		<sql>
			<file driver="mysql" charset="utf8">sql/uninstall/mysql/uninstall.sql</file>
		</sql>
	</uninstall>

	<update>
		<schemas>
			<schemapath type="mysql">sql/updates/mysql</schemapath>
		</schemas>
	</update>

	<administration>
		<menu img="class:users">COM_VOLUNTEERTRACKER</menu>
		<submenu>
			<menu link="option=com_volunteertracker" view="dashboard" img="class:dashboard">COM_VOLUNTEERTRACKER_DASHBOARD_MENU</menu>
			<menu link="option=com_volunteertracker&amp;view=event&amp;layout=edit" view="event" img="class:calendar">COM_VOLUNTEERTRACKER_EVENT_INPUT_MENU</menu>
			<menu link="option=com_volunteertracker&amp;view=volunteer&amp;layout=edit" view="volunteer" img="class:new">COM_VOLUNTEERTRACKER_VOLUNTEER_INPUT_MENU</menu>
			<menu link="option=com_volunteertracker&amp;view=reports" view="reports" img="class:list">COM_VOLUNTEERTRACKER_REPORTS_MENU</menu>
		</submenu>
		<files folder="admin">
			<filename>access.xml</filename>
			<folder>language</folder>
			<folder>services</folder>
			<folder>sql</folder>
			<folder>src</folder>
			<folder>tmpl</folder>
		</files>
	</administration>

	<media destination="com_volunteertracker" folder="media">
		<filename>joomla.asset.json</filename>
		<folder>css</folder>
		<folder>js</folder>
	</media>

	<updateservers>
		<server type="extension" priority="1" name="Volunteer Tracker GitHub Updates">https://raw.githubusercontent.com/kanebrands/volunteer-tracker/main/updates/com_volunteertracker.xml</server>
	</updateservers>
</extension>
